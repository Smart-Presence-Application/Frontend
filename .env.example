# Base URL of the Django API. Keep "/api" in development so Vite proxies it (needed for HttpOnly cookies).
VITE_API_BASE_URL=/api
# Shown on the privacy policy as the address for privacy questions.
VITE_CONTACT_EMAIL=hello@smartpresence.app
# Public address of the site, for canonical links and link previews (no trailing slash).
VITE_SITE_URL=https://smartpresence.tech
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to turn analytics off.
VITE_GA_MEASUREMENT_ID=
# Cloudflare Turnstile site key for the contact form's spam check. Leave empty to skip it.
# Cloudflare's test key that always passes: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
